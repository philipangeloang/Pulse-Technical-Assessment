// Pulse — coordination store only. Nothing here is durable user data:
// rows are deleted on leave, on staleness, or after a signal is delivered.
// Chat text and video are NOT modeled — they ride WebRTC peer-to-peer and
// never reach the server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Presence {
  id        String   @id @default(uuid()) // public session id (server-assigned)
  tokenHash String   @unique // sha256 of the session's secret bearer token
  lat       Float // ALREADY privacy-offset coords (raw is never stored)
  lng       Float
  // Session id of the current connection partner; null = available.
  // Knowing *who* the partner is (not just "busy") lets leave/reap/end
  // free the other side too.
  peerId    String?
  // Session id this user has an outstanding connection request to. Only
  // that user may accept/decline it; the server enforces the handshake.
  pendingTo String?
  lastSeen  DateTime

  @@index([lastSeen])
  @@index([pendingTo])
}

model Signal {
  // Mailbox for connection requests + WebRTC signaling only.
  id        String   @id @default(uuid())
  toId      String // recipient session id
  fromId    String // sender session id
  type      String // request | accept | decline | offer | answer | ice | end
  payload   String? // JSON string (SDP / ICE candidate)
  createdAt DateTime @default(now())

  @@index([toId])
}
